<?xml version="1.0"?>
<!--
  - local-types.xml
  -
  - An empty registry for instance-specific, local metadata. Any non-standard
  - metadata fields should be added here to avoid polluting the standard
  - namespaces.
  - 
  -->
<dspace-dc-types>

  <dspace-header>
    <title>Registry of instance-specific metadata fields</title>
    <contributor.author>Ivan Mas&#xE1;r</contributor.author>
    <contributor.editor>$Author$</contributor.editor>
    <date.created>$Date$</date.created>
    <description>$Log$</description>
    <description.version>$Revision$</description.version>
  </dspace-header>

  <dc-schema>
    <name>local</name>
    <namespace>http://dspace.org/namespace/local/</namespace>
  </dc-schema>

  <!-- Campos customizados RDAPP — HU002 v1.4 (homologada 29/04/2026) -->

  <dc-type>
    <schema>local</schema>
    <element>tipodocumento</element>
    <qualifier></qualifier>
    <scope_note>Tipo principal do documento de avaliação (ex: Relatório de avaliação, Nota Técnica).</scope_note>
  </dc-type>

  <dc-type>
    <schema>local</schema>
    <element>tipoavaliacao</element>
    <qualifier></qualifier>
    <scope_note>Tipo de avaliação realizada (ex: Ex ante, Ex post: Avaliação de impacto). Repetível.</scope_note>
  </dc-type>

  <dc-type>
    <schema>local</schema>
    <element>politicapublica</element>
    <qualifier></qualifier>
    <scope_note>Política pública ou objeto avaliado no documento. Lista controlada + texto livre. Repetível.</scope_note>
  </dc-type>

  <dc-type>
    <schema>local</schema>
    <element>areatematica</element>
    <qualifier></qualifier>
    <scope_note>Área temática associada à política pública ou objeto avaliado. Repetível.</scope_note>
  </dc-type>

  <dc-type>
    <schema>local</schema>
    <element>instituicao</element>
    <qualifier></qualifier>
    <scope_note>Instituição responsável pelo upload do documento (ex: CMAP, IPEA, ENAP).</scope_note>
  </dc-type>

  <dc-type>
    <schema>local</schema>
    <element>abrangencia</element>
    <qualifier></qualifier>
    <scope_note>Recorte territorial da política pública avaliada (ex: Nacional, Estadual, Municipal). Repetível.</scope_note>
  </dc-type>

  <dc-type>
    <schema>local</schema>
    <element>ods</element>
    <qualifier></qualifier>
    <scope_note>Objetivo de Desenvolvimento Sustentável relacionado à política avaliada. Repetível.</scope_note>
  </dc-type>

  <dc-type>
    <schema>local</schema>
    <element>uf</element>
    <qualifier></qualifier>
    <scope_note>Unidade da Federação associada à instituição responsável pela avaliação.</scope_note>
  </dc-type>

  <dc-type>
    <schema>local</schema>
    <element>cidade</element>
    <qualifier></qualifier>
    <scope_note>Município associado à instituição responsável pela avaliação. Populado via API IBGE filtrado por local.uf.</scope_note>
  </dc-type>

</dspace-dc-types>
